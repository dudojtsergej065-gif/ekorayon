<%- include('partials/header') %><section class="page-head"><h1>Запросы по классам</h1></section><div class="table-wrap"><table><thead><tr><th>Школа</th><th>Действие</th><th>Класс</th><th>Статус</th><th>Решение</th></tr></thead><tbody><% requests.forEach(r=>{ %><tr><td><%= r.school_name %></td><td><%= r.action==='add'?'Добавить':'Удалить' %></td><td><%= r.class_name %></td><td><%= r.status %></td><td><% if(r.status==='pending'){ %><form method="post" action="/admin/class-requests/<%= r.id %>" class="inline-form"><button class="btn tiny" name="status" value="approved">Одобрить</button><button class="btn tiny danger" name="status" value="rejected">Отклонить</button></form><% } %></td></tr><% }) %></tbody></table></div><%- include('partials/footer') %>
