<%- include('partials/header') %><section class="page-head"><span class="eyebrow">ЛИЧНЫЙ КАБИНЕТ ШКОЛЫ</span><h1><%= school.name %></h1><p>Управляйте результатами, классами и обращениями.</p><a class="btn primary" href="/entries/new">＋ Добавить сбор</a></section><section class="panel points-school-card"><span class="eyebrow">МОТИВАЦИЯ И ДОСТИЖЕНИЯ</span><h2>Баланс школы</h2><strong class="school-points-total"><%= Number(points||0).toLocaleString('ru-RU',{maximumFractionDigits:2}) %> баллов</strong><p class="muted">Баллы начисляются за подтверждённые сдачи и экологические мероприятия.</p><h3>История баллов</h3><% if(pointHistory&&pointHistory.length){ pointHistory.forEach(p=>{ %><div class="simple-row"><b><%= p.points>0?'+':'' %><%= Number(p.points).toLocaleString('ru-RU',{maximumFractionDigits:2}) %> баллов</b><p><%= p.reason %></p><small><%= new Date(p.created_at).toLocaleDateString('ru-RU') %></small></div><% }) } else { %><p class="muted">Начислений пока нет.</p><% } %><div class="certificates-school-panel"><h3>🏆 Мои грамоты</h3><p class="muted">Грамоты за подтверждённые сдачи можно скачать и распечатать.</p><% if(certificates&&certificates.length){ %><div class="certificate-list"><% certificates.forEach(c=>{ %><div class="certificate-row"><div><b><%= c.recipient_name %></b><small><%= c.material_name %> · <%= c.quantity %> <%= c.unit %> · <%= c.serial_number %></small></div><a class="btn small" href="/certificates/<%= c.id %>/pdf" target="_blank">Скачать PDF</a></div><% }) %></div><% } else { %><p class="muted">Грамоты появятся здесь после подтверждения записей.</p><% } %></div></section><div class="dashboard-grid"><section class="panel"><div class="section-head"><h2>Численность учащихся</h2></div><form method="post" action="/school/students" class="inline-form"><input type="number" name="students" min="0" value="<%= school.students %>" required><button class="btn small">Сохранить</button></form><h3>Классы</h3><% classes.forEach(c=>{ %><form method="post" action="/school/classes/<%= c.id %>/students" class="metric-row"><span><%= c.name %></span><input class="mini-input" type="number" name="students" min="0" value="<%= c.students %>"><button class="btn tiny">✓</button></form><% }) %><form method="post" action="/school/classes/request" class="stack-form"><h3>Запрос по классу</h3><select name="action"><option value="add">Добавить класс</option><option value="remove">Удалить класс</option></select><input name="class_name" placeholder="Например, 7А" required><button class="btn small">Отправить запрос</button></form></section><section class="panel"><h2>Последние записи</h2><div class="entry-list"><% entries.forEach(e=>{ %><div class="entry"><div><b><%= e.material_name %></b><small><%= e.class_name||'Общий сбор' %> · <%= new Date(e.created_at).toLocaleDateString('ru-RU') %></small><% if(e.review_comment){ %><small class="warning-text"><%= e.review_comment %></small><% } %></div><div class="entry-right"><b><%= e.quantity %> кг</b><span class="status <%= e.status %>"><%= e.status==='approved'?'Подтверждено':e.status==='correction'?'Требует исправления':'Ожидает проверки' %></span></div></div><% if(e.status==='correction'){ %><form method="post" action="/entries/<%= e.id %>/resubmit" class="inline-form"><input type="number" name="quantity" min="0.01" step="0.01" value="<%= e.quantity %>" required><input name="note" placeholder="Комментарий"><button class="btn small">Исправить и отправить</button></form><% } %><% }) %><% if(!entries.length){ %><p class="muted">Пока нет записей.</p><% } %></div></section><section class="panel"><h2>Уведомления</h2><% notifications.forEach(n=>{ %><div class="simple-row"><b><%= n.title %></b><p><%= n.body %></p><small><%= new Date(n.created_at).toLocaleString('ru-RU') %></small></div><% }) %><a href="/notifications" class="text-link">Все уведомления →</a></section><section class="panel"><h2>Техническая поддержка</h2><form method="post" action="/school/support" class="stack-form"><input name="subject" placeholder="Тема обращения" required><textarea name="message" placeholder="Опишите проблему" required rows="3"></textarea><button class="btn small">Отправить обращение</button></form><% tickets.forEach(t=>{ %><div class="simple-row"><b><%= t.subject %></b><small><%= t.status %></small><% if(t.admin_reply){ %><p>Ответ: <%= t.admin_reply %></p><% } %></div><% }) %></section></div><%- include('partials/footer') %>
