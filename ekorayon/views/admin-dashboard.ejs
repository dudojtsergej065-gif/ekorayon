<%- include('partials/header') %><section class="page-head"><span class="eyebrow">АДМИНИСТРИРОВАНИЕ</span><h1>Панель администрации</h1><p>Обзор работы платформы и проверка поступивших результатов.</p></section><div class="stats-grid"><div class="stat"><span>Активных школ</span><strong><%= counts.schools %></strong></div><div class="stat"><span>Ожидают проверки</span><strong><%= counts.pending %></strong></div><div class="stat"><span>Новые обращения</span><strong><%= counts.feedback %></strong></div><div class="stat"><span>Поддержка</span><strong><%= counts.tickets %></strong></div></div><div class="admin-links"><a class="btn primary" href="/admin/schools">Школы</a><a class="btn ghost" href="/admin/schools/new">＋ Добавить школу</a><a class="btn ghost" href="/admin/users/new">Создать аккаунт</a><a class="btn ghost" href="/admin/news">Новости</a><a class="btn ghost" href="/admin/points">⭐ Баллы и тарифы</a><a class="btn ghost" href="/admin/missions">🌱 Управление экозаданиями</a><a class="btn ghost" href="/admin/inbox">Обращения</a><a class="btn ghost" href="/reports">Отчёты</a><a class="btn ghost" href="/admin/class-requests">Запросы классов</a><% if(user.role==='admin'){ %><a class="btn ghost" href="/admin/audit">Журнал действий</a><% } %></div><section class="section"><h2>Поступившие записи</h2><div class="table-wrap"><table><thead><tr><th>Школа / класс</th><th>Вид</th><th>Количество</th><th>Статус</th><th>Действие</th></tr></thead><tbody><% entries.forEach(e=>{ %><tr><td><b><%= e.school_name %></b><small class="table-sub"><%= e.class_name||'Общий сбор' %></small></td><td><%= e.material_name %></td><td><%= e.quantity %> кг</td><td><span class="status <%= e.status %>"><%= e.status %></span></td><td><% if(e.status!=='approved'){ %><form method="post" action="/admin/entries/<%= e.id %>/review" class="review-form"><input type="hidden" name="status" value="approved"><button class="btn tiny">Подтвердить</button></form><form method="post" action="/admin/entries/<%= e.id %>/review" class="review-form"><input type="hidden" name="status" value="correction"><input name="review_comment" placeholder="Что исправить?" required><button class="btn tiny danger">На исправление</button></form><% }else{ %>—<% } %></td></tr><% }) %></tbody></table><% if(!entries.length){ %><div class="empty">Новых записей пока нет.</div><% } %></div></section><%- include('partials/footer') %>
