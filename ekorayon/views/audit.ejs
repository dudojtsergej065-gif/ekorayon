<%- include('partials/header') %><section class="page-head"><h1>Журнал действий</h1><p>Последние административные действия.</p></section><div class="table-wrap"><table><thead><tr><th>Дата</th><th>Пользователь</th><th>Действие</th><th>Раздел</th><th>Данные</th></tr></thead><tbody><% items.forEach(x=>{ %><tr><td><%= new Date(x.created_at).toLocaleString('ru-RU') %></td><td><%= x.user_name||'Система' %></td><td><%= x.action %></td><td><%= x.entity||'—' %></td><td><%= JSON.stringify(x.details||{}) %></td></tr><% }) %></tbody></table></div><%- include('partials/footer') %>
