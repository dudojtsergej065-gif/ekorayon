<%- include('partials/header') %><section class="form-wrap wide"><span class="eyebrow"><%= t('КАБИНЕТ ШКОЛЫ','КАБІНЕТ ШКОЛЫ') %></span><h1><%= t('Новая запись вторсырья','Новы запіс другаснай сыравіны') %></h1><form method="post" action="/entries" class="panel form two-col"><label><%= t('Класс','Клас') %><select name="class_id"><option value=""><%= t('Общий сбор школы','Агульны збор школы') %></option><% classes.forEach(c=>{ %><option value="<%= c.id %>"><%= c.name %></option><% }) %></select></label><label><%= t('Кому оформить грамоту','Каму аформіць грамату') %><select name="certificate_type" id="certificate-type"><option value="auto"><%= t('Автоматически: школе или классу','Аўтаматычна: школе або класу') %></option><option value="school"><%= t('Школе','Школе') %></option><option value="class"><%= t('Классу','Класу') %></option><option value="student"><%= t('Ученику','Вучню') %></option></select><small class="muted">Для грамоты ученику укажите имя и выберите класс.</small></label><label><%= t('Имя ученика (если грамота ученику)','Імя вучня (калі грамата вучню)') %><input name="student_name" maxlength="120" placeholder="Фамилия и имя ученика"></label><label><%= t('Вид вторсырья','Від другаснай сыравіны') %><select name="material_code" required><% materials.forEach(m=>{ %><option value="<%= m.code %>"><%= m.name %></option><% }) %></select></label><label><%= t('Количество, кг','Колькасць, кг') %><input type="number" name="quantity" min="0.01" step="0.01" required></label><label><%= t('Отчётный месяц','Справаздачны месяц') %><input type="month" name="period_month" value="<%= new Date().toISOString().slice(0,7) %>" required></label><label class="full"><%= t('Комментарий (необязательно)','Каментарый (неабавязкова)') %><textarea name="note" rows="3"></textarea></label><button class="btn primary"><%= t('Отправить запись','Адправіць запіс') %></button></form></section><%- include('partials/footer') %>
