<%- include('partials/header') %><section class="page-head"><h1>Новости и мероприятия</h1><p>Публикации районной администрации.</p></section><form method="post" action="/admin/news" class="panel form"><label>Заголовок<input name="title" required></label><label>Категория<select name="category"><option value="news">Новость</option><option value="event">Мероприятие</option><option value="announcement">Объявление</option></select></label><label>Текст<textarea name="body" rows="5" required></textarea></label><label>Дата мероприятия (необязательно)<input type="date" name="event_date"></label><button class="btn primary">Опубликовать</button></form><section class="section"><h2>Все материалы</h2><div class="news-grid"><% items.forEach(n=>{ %><div class="news-card"><span class="tag"><%= n.status %></span><h3><%= n.title %></h3><p><%= n.body.slice(0,160) %></p><form method="post" action="/admin/news/<%= n.id %>/status" class="inline-form"><select name="status"><option value="published">Опубликовано</option><option value="archived">Архивировать</option><option value="draft">Снять с публикации</option></select><button class="btn tiny">Сохранить</button></form></div><% }) %></div></section><%- include('partials/footer') %>
