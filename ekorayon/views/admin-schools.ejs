<%- include('partials/header') %><section class="page-head"><span class="eyebrow">АДМИНИСТРИРОВАНИЕ</span><h1>Управление школами</h1><a class="btn primary" href="/admin/schools/new">＋ Добавить школу</a> <a class="btn ghost" href="/admin/users/new">Создать аккаунт школы</a></section><div class="table-wrap"><table><thead><tr><th>Школа</th><th>Населённый пункт</th><th>Учащихся</th><th>Аккаунтов</th><th>Статус</th><th>Управление</th></tr></thead><tbody><% schools.forEach(s=>{ %><tr><td><b><%= s.name %></b></td><td><%= s.locality||'—' %></td><td><%= s.students %></td><td><%= s.users_count %></td><td><%= s.status %></td><td><form method="post" action="/admin/schools/<%= s.id %>/status" class="inline-form"><select name="status"><option value="active" <%= s.status==='active'?'selected':'' %>>Активна</option><option value="paused" <%= s.status==='paused'?'selected':'' %>>Приостановлена</option><option value="archived" <%= s.status==='archived'?'selected':'' %>>Архив</option></select><button class="btn tiny">Сохранить</button></form><% if(user.role==='admin'){ %><form method="post" action="/admin/schools/<%= s.id %>/delete" class="inline-form" onsubmit="return confirm('Удалить школу и все связанные данные без возможности восстановления?')"><input type="hidden" name="confirm" value="DELETE"><button class="btn tiny danger">Удалить</button></form><% } %></td></tr><% }) %></tbody></table></div><%- include('partials/footer') %>
