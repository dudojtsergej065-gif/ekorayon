<%- include('partials/header') %><section class="page-head"><span class="eyebrow">🏅 ЭКОКОЛЛЕКЦИЯ</span><h1><%= lang==='by'?'Калекцыя дасягненняў':'Коллекция достижений' %></h1><p><%= lang==='by'?'Значкі, якія школы атрымліваюць за пацверджаныя вынікі.':'Значки, которые школы получают за подтверждённые результаты сбора.' %></p></section><div class="achievement-grid"><% items.forEach(a=>{ %><article class="achievement-card"><span class="achievement-icon"><%= a.icon %></span><h2><%= lang==='by'?a.title_by:a.title_ru %></h2><p><%= lang==='by'?a.description_by:a.description_ru %></p><strong><%= Number(a.threshold_kg).toLocaleString(lang==='by'?'be-BY':'ru-RU') %> кг</strong><small><%= a.earned_count %> <%= lang==='by'?'узнагароджанняў':'награждений' %></small></article><% }) %></div><section class="section"><h2><%= lang==='by'?'Апошнія ўзнагароды':'Последние награды' %></h2><div class="hall-list"><% earned.forEach(a=>{ %><div class="hall-row"><span><%= a.icon %></span><b><%= a.school_name %></b><span><%= lang==='by'?a.title_by:a.title_ru %></span><small><%= new Date(a.earned_at).toLocaleDateString(lang==='by'?'be-BY':'ru-RU') %></small></div><% }) %><% if(!earned.length){ %><div class="empty">Первые награды появятся после подтверждения результатов.</div><% } %></div></section><%- include('partials/footer') %>