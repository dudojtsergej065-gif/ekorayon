<%- include('partials/header') %>

<section class="page-head ratings-head">
  <span class="eyebrow">ЭКО-ЛИДЕРЫ РАЙОНА</span>
  <h1>Рейтинг <em>ЭКОРАЙОНА</em></h1>
  <p>Сравниваем реальные результаты школ и классов по собранному вторсырью. В рейтинг входят записи, ожидающие проверки, и подтверждённые записи.</p>
  <div class="ratings-head-note"><span class="ratings-pulse"></span> Главный рейтинг — по фактической массе, без баллов</div>
</section>

<section class="section ratings-main-section">
  <div class="ratings-section-title">
    <div><span class="eyebrow">КТО ВПЕРЕДИ?</span><h2>Лидеры ЭКОРАЙОНА</h2></div>
    <span class="ratings-unit">Общий сбор · кг</span>
  </div>

  <% if (schools.length) { %>
    <div class="ratings-podium">
      <% schools.slice(0,3).forEach((s,i)=>{ %>
        <a class="ratings-podium-card place-<%= i+1 %>" href="/schools/<%= s.id %>">
          <span class="podium-medal"><%= i===0 ? '🏆' : (i===1 ? '🥈' : '🥉') %></span>
          <span class="podium-place"><%= i+1 %> МЕСТО</span>
          <strong class="podium-school"><%= s.name %></strong>
          <span class="podium-total"><%= Number(s.total).toLocaleString('ru-RU',{maximumFractionDigits:2}) %> <small>кг</small></span>
          <span class="podium-caption">Вклад в чистое будущее</span>
        </a>
      <% }) %>
    </div>

    <div class="table-wrap ratings-table-wrap">
      <table class="ratings-table">
        <thead><tr><th>Место</th><th>Школа</th><th>Собрано вторсырья</th><th></th></tr></thead>
        <tbody>
          <% schools.forEach((s,i)=>{ %>
            <tr>
              <td><span class="rank-badge ratings-rank"><%= i+1 %></span></td>
              <td><a class="ratings-school-link" href="/schools/<%= s.id %>"><%= s.name %></a></td>
              <td><strong class="ratings-kg"><%= Number(s.total).toLocaleString('ru-RU',{maximumFractionDigits:2}) %> кг</strong></td>
              <td><a class="ratings-open-link" href="/schools/<%= s.id %>">Открыть школу ↗</a></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  <% } else { %>
    <div class="empty ratings-empty">Пока нет результатов. Как только школы внесут данные, здесь появятся первые лидеры!</div>
  <% } %>
</section>

<section class="section ratings-panel" style="margin:22px 0;border-color:#8b7b36;background:linear-gradient(145deg,#282719,#172522)">
  <div class="ratings-section-title">
    <div><span class="eyebrow">НАГРАДЫ И ДОСТИЖЕНИЯ</span><h2>Мотивационный рейтинг</h2></div>
    <span class="ratings-icon">⭐</span>
  </div>
  <p style="color:#d8e8d9;line-height:1.7;margin:0 0 10px">Это отдельный рейтинг по баллам: за сдачу разных видов вторсырья и участие в экологических мероприятиях. Баллы не прибавляются к килограммам и не влияют на основной рейтинг.</p>
  <div class="empty" style="background:#172522;color:#c8d8c8;border-color:#746b35">Система начисления баллов и настройки тарифов администратора ещё подключаются. Как только она будет готова, здесь появятся школы-лидеры и их достижения. Баллы пока не рассчитываются и не отображаются, чтобы не показывать вымышленные результаты.</div>
</section>

<div class="detail-grid ratings-detail-grid">
  <section class="section ratings-panel">
    <div class="ratings-section-title"><div><span class="eyebrow">КОМАНДНЫЙ РЕЗУЛЬТАТ</span><h2>Рейтинг классов</h2></div><span class="ratings-icon">🎓</span></div>
    <% if (classes.length) { %>
      <div class="table-wrap"><table class="ratings-table"><thead><tr><th>Класс</th><th>Школа</th><th>Сбор</th></tr></thead><tbody>
        <% classes.forEach((c,i)=>{ %><tr><td><span class="rank-badge"><%= i+1 %></span> <strong><%= c.class_name %></strong></td><td><%= c.school_name %></td><td><strong class="ratings-kg"><%= Number(c.total).toLocaleString('ru-RU',{maximumFractionDigits:2}) %> кг</strong></td></tr><% }) %>
      </tbody></table></div>
    <% } else { %><div class="empty">Результаты классов появятся после внесения данных.</div><% } %>
  </section>

  <section class="section ratings-panel">
    <div class="ratings-section-title"><div><span class="eyebrow">ЧТО СДАЮТ ЧАЩЕ?</span><h2>Виды вторсырья</h2></div><span class="ratings-icon">♻️</span></div>
    <div class="ratings-material-list">
      <% materials.forEach((m,i)=>{ %>
        <div class="ratings-material-item"><span class="ratings-material-number"><%= i+1 %></span><span class="ratings-material-name"><%= m.name %></span><strong><%= Number(m.total).toLocaleString('ru-RU',{maximumFractionDigits:2}) %> кг</strong></div>
      <% }) %>
    </div>
  </section>
</div>

<div class="detail-grid ratings-period-grid">
  <section class="section ratings-period-card">
    <span class="eyebrow">АКТИВНОСТЬ СЕЙЧАС</span><h2>Рейтинг месяца</h2>
    <% if (monthly.length) { %><div class="ratings-period-list"><% monthly.forEach((s,i)=>{ %><div class="ratings-period-row"><span class="rank-badge"><%= i+1 %></span><span><%= s.name %></span><strong><%= Number(s.total).toLocaleString('ru-RU',{maximumFractionDigits:2}) %> кг</strong></div><% }) %></div><% } else { %><div class="empty">За этот месяц записей пока нет.</div><% } %>
  </section>
  <section class="section ratings-period-card">
    <span class="eyebrow">БОЛЬШОЙ ВКЛАД</span><h2>Рейтинг года</h2>
    <% if (yearly.length) { %><div class="ratings-period-list"><% yearly.forEach((s,i)=>{ %><div class="ratings-period-row"><span class="rank-badge"><%= i+1 %></span><span><%= s.name %></span><strong><%= Number(s.total).toLocaleString('ru-RU',{maximumFractionDigits:2}) %> кг</strong></div><% }) %></div><% } else { %><div class="empty">За этот год записей пока нет.</div><% } %>
  </section>
</div>

<%- include('partials/footer') %>
