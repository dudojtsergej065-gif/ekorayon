<%- include('partials/header') %><section class="page-head"><span class="eyebrow"><%= t('ЛИЧНЫЙ КАБИНЕТ ШКОЛЫ','АСАБІСТЫ КАБІНЕТ ШКОЛЫ') %></span><h1><%= school.name %></h1><p><%= t('Управляйте результатами, классами и обращениями.','Кіруйце вынікамі, класамі і зваротамі.') %></p><a class="btn primary" href="/entries/new"><%= t('＋ Добавить сбор','＋ Дадаць збор') %></a><a class="btn ghost" href="/missions">🌱 <%= t('Экозадания','Эказаданні') %></a><a class="btn ghost" href="/achievements">🏅 <%= t('Достижения','Дасягненні') %></a></section><section class="panel avatar-customizer"><div><span class="eyebrow"><%= t('ЛИЦО НАШЕЙ КОМАНДЫ','ТВАР НАШАЙ КАМАНДЫ') %></span><h2>🎭 <%= t('Выбери талисман школы','Выберы талісман школы') %></h2><p class="muted"><%= t('Открывай новых персонажей, набирая мотивационные баллы.','Адкрывай новых персанажаў, набіраючы матывацыйныя балы.') %></p></div><div class="avatar-choices"><% (avatarOptions||[]).forEach(a=>{ %><form method="post" action="/school/avatar"><input type="hidden" name="avatar_code" value="<%= a.code %>"><button class="avatar-choice <%= school.avatar_code===a.code?'selected':'' %>" title="<%= lang==='by'?a.nameBy:a.name %>"><span><%= a.icon %></span><b><%= lang==='by'?a.nameBy:a.name %></b><small><%= a.points %> ⭐</small></button></form><% }) %></div><small class="muted"><%= t('Баланс команды:','Баланс каманды:') %> <b><%= avatarPoints %></b> ⭐</small></section><section class="panel badge-strip"><h2>🏅 <%= t('Наши достижения','Нашы дасягненні') %></h2><div class="badge-strip-list"><% if(badges&&badges.length){ badges.forEach(b=>{ %><div class="badge-token"><span><%= b.icon %></span><b><%= lang==='by'?b.title_by:b.title_ru %></b></div><% }) } else { %><p class="muted"><%= t('Первые значки появятся после подтверждения собранного вторсырья.','Першыя значкі з’явяцца пасля пацвярджэння сабранай другаснай сыравіны.') %></p><% } %></div></section><section class="panel points-school-card"><span class="eyebrow"><%= t('МОТИВАЦИЯ И ДОСТИЖЕНИЯ','МАТЫВАЦЫЯ І ДАСЯГНЕННІ') %></span><h2><%= t('Баланс школы','Баланс школы') %></h2><strong class="school-points-total"><%= Number(points||0).toLocaleString('ru-RU',{maximumFractionDigits:2}) %> баллов</strong>
<% const xp=Math.max(0,Number(points)||0); const levels=[{name:'Эко-новичок',icon:'🌱',min:0,next:50},{name:'Друг природы',icon:'🍃',min:50,next:150},{name:'Защитник планеты',icon:'🌍',min:150,next:350},{name:'Эко-хранитель',icon:'🛡️',min:350,next:700},{name:'Легенда ЭКОРАЙОНА',icon:'🏆',min:700,next:null}]; const level=[...levels].reverse().find(x=>xp>=x.min)||levels[0]; const nextLevel=levels[levels.indexOf(level)+1]; const progress=nextLevel?Math.min(100,Math.max(0,((xp-level.min)/(nextLevel.min-level.min))*100)):100; %>
<div class="eco-level-card"><div class="eco-level-top"><div><span class="eyebrow">УРОВЕНЬ КОМАНДЫ</span><h3><%= level.icon %> <%= level.name %></h3></div><b><%= nextLevel?Math.floor(progress)+'%':'МАКСИМУМ' %></b></div><div class="eco-level-track"><span style="width:<%= progress %>%"></span></div><p><%= nextLevel?'До следующего уровня осталось '+Math.max(0,nextLevel.min-xp)+' баллов.':'Вы достигли высшего уровня! Ваша команда — легенда ЭКОРАЙОНА!' %></p><small><%= nextLevel?xp+' / '+nextLevel.min+' баллов':'700+ баллов' %></small></div><p class="muted">Баллы начисляются за подтверждённые сдачи и экологические мероприятия.</p><h3><%= t('История баллов','Гісторыя балаў') %></h3><% if(pointHistory&&pointHistory.length){ pointHistory.forEach(p=>{ %><div class="simple-row"><b><%= p.points>0?'+':'' %><%= Number(p.points).toLocaleString('ru-RU',{maximumFractionDigits:2}) %> баллов</b><p><%= p.reason %></p><small><%= new Date(p.created_at).toLocaleDateString('ru-RU') %></small></div><% }) } else { %><p class="muted">Начислений пока нет.</p><% } %><div class="certificates-school-panel"><h3>🏆 <%= t('Мои грамоты','Мае граматы') %></h3><p class="muted">Грамоты за подтверждённые сдачи можно скачать и распечатать.</p><% if(certificates&&certificates.length){ %><div class="certificate-list"><% certificates.forEach(c=>{ %><div class="certificate-row"><div><b><%= c.recipient_name %></b><small><%= c.material_name %> · <%= c.quantity %> <%= c.unit %> · <%= c.serial_number %></small></div><a class="btn small" href="/certificates/<%= c.id %>/pdf" target="_blank">Скачать грамоту</a></div><% }) %></div><% } else { %><p class="muted">Грамоты появятся здесь после подтверждения записей.</p><% } %></div></section><div class="dashboard-grid"><section class="panel"><div class="section-head"><h2>Численность учащихся</h2></div><form method="post" action="/school/students" class="inline-form"><input type="number" name="students" min="0" value="<%= school.students %>" required><button class="btn small">Сохранить</button></form><h3>Классы</h3><% classes.forEach(c=>{ %><form method="post" action="/school/classes/<%= c.id %>/students" class="metric-row"><span><%= c.name %></span><input class="mini-input" type="number" name="students" min="0" value="<%= c.students %>"><button class="btn tiny">✓</button></form><% }) %><form method="post" action="/school/classes/request" class="stack-form"><h3>Запрос по классу</h3><select name="action"><option value="add">Добавить класс</option><option value="remove">Удалить класс</option></select><input name="class_name" placeholder="Например, 7А" required><button class="btn small">Отправить запрос</button></form></section><section class="panel"><h2><%= t('Последние записи','Апошнія запісы') %></h2><div class="entry-list"><% entries.forEach(e=>{ %><div class="entry"><div><b><%= e.material_name %></b><small><%= e.class_name||'Общий сбор' %> · <%= new Date(e.created_at).toLocaleDateString('ru-RU') %></small><% if(e.review_comment){ %><small class="warning-text"><%= e.review_comment %></small><% } %></div><div class="entry-right"><b><%= e.quantity %> кг</b><span class="status <%= e.status %>"><%= e.status==='approved'?'Подтверждено':e.status==='correction'?'Требует исправления':'Ожидает проверки' %></span></div></div><% if(e.status==='correction'){ %><form method="post" action="/entries/<%= e.id %>/resubmit" class="inline-form"><input type="number" name="quantity" min="0.01" step="0.01" value="<%= e.quantity %>" required><input name="note" placeholder="Комментарий"><button class="btn small">Исправить и отправить</button></form><% } %><% }) %><% if(!entries.length){ %><p class="muted">Пока нет записей.</p><% } %></div></section><section class="panel"><h2><%= t('Уведомления','Апавяшчэнні') %></h2><% notifications.forEach(n=>{ %><div class="simple-row"><b><%= n.title %></b><p><%= n.body %></p><small><%= new Date(n.created_at).toLocaleString('ru-RU') %></small></div><% }) %><a href="/notifications" class="text-link">Все уведомления →</a></section><section class="panel"><h2><%= t('Техническая поддержка','Тэхнічная падтрымка') %></h2><form method="post" action="/school/support" class="stack-form"><input name="subject" placeholder="Тема обращения" required><textarea name="message" placeholder="Опишите проблему" required rows="3"></textarea><button class="btn small">Отправить обращение</button></form><% tickets.forEach(t=>{ %><div class="simple-row"><b><%= t.subject %></b><small><%= t.status==='new'?'Новое':t.status==='in_progress'?'В работе':t.status==='answered'?'Отвечено':t.status==='closed'?'Закрыто':t.status==='open'?'Открыто':t.status %></small><% if(t.admin_reply){ %><p>Ответ: <%= t.admin_reply %></p><% } %></div><% }) %></section></div><%- include('partials/footer') %>
