<%- include('partials/header') %><section class="page-head"><span class="eyebrow">ФАКТИЧЕСКИЕ РЕЗУЛЬТАТЫ</span><h1>Рейтинги ЭКОРАЙОНА</h1><p>Рейтинги рассчитываются по фактической массе вторсырья. Предварительные и подтверждённые записи учитываются, а статус проверки отображается в личном кабинете.</p></section><section class="section"><h2>Общий рейтинг школ</h2><div class="table-wrap"><table><thead><tr><th>Место</th><th>Школа</th><th>Собрано</th></tr></thead><tbody><% schools.forEach((s,i)=>{ %><tr><td><span class="rank-badge"><%= i+1 %></span></td><td><a href="/schools/<%= s.id %>"><%= s.name %></a></td><td><b><%= Number(s.total).toLocaleString('ru-RU') %> кг</b></td></tr><% }) %></tbody></table><% if(!schools.length){ %><div class="empty">Результаты появятся после внесения данных школами.</div><% } %></div></section><div class="detail-grid"><section class="section"><h2>Рейтинг классов района</h2><div class="table-wrap"><table><thead><tr><th>Класс</th><th>Школа</th><th>Кг</th></tr></thead><tbody><% classes.forEach(c=>{ %><tr><td><b><%= c.class_name %></b></td><td><%= c.school_name %></td><td><%= c.total %></td></tr><% }) %></tbody></table></div></section><section class="section"><h2>Лидеры по видам вторсырья</h2><div class="material-grid one-col"><% materials.forEach(m=>{ %><div class="material-card"><b><%= m.name %></b><strong><%= Number(m.total).toLocaleString('ru-RU') %> кг</strong></div><% }) %></div></section></div><div class="detail-grid"><section class="section"><h2>Рейтинг текущего месяца</h2><div class="table-wrap"><table><thead><tr><th>Школа</th><th>Кг</th></tr></thead><tbody><% monthly.forEach(s=>{ %><tr><td><%= s.name %></td><td><%= s.total %></td></tr><% }) %></tbody></table></div></section><section class="section"><h2>Рейтинг текущего года</h2><div class="table-wrap"><table><thead><tr><th>Школа</th><th>Кг</th></tr></thead><tbody><% yearly.forEach(s=>{ %><tr><td><%= s.name %></td><td><%= s.total %></td></tr><% }) %></tbody></table></div></section></div><%- include('partials/footer') %>
