<%- include('partials/header') %><section class="page-head"><span class="eyebrow">ЭКОСОБЫТИЯ</span><h1>Новости и мероприятия</h1><p>Новости школ, районные объявления и экологические акции.</p></section><div class="news-grid"><% items.forEach(n=>{ %><a class="news-card" href="/news/<%= n.id %>"><span class="tag"><%= n.category %></span><h3><%= n.title %></h3><p><%= n.body.slice(0,170) %><%= n.body.length>170?'…':'' %></p><small><%= new Date(n.created_at).toLocaleDateString('ru-RU') %></small></a><% }) %><% if(!items.length){ %><div class="empty">Материалы появятся после публикации.</div><% } %></div><%- include('partials/footer') %>
