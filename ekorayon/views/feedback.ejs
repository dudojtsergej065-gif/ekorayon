<%- include('partials/header') %><section class="form-wrap"><span class="eyebrow">МЫ НА СВЯЗИ</span><h1>Обратная связь</h1><% if(typeof success!=='undefined'&&success){ %><div class="notice"><%= success %></div><% }else{ %><form method="post" class="panel form"><label>Ваше имя<input name="name" required></label><label>Контакт для ответа<input name="contact" required></label><label>Тема<input name="subject" required></label><label>Сообщение<textarea name="message" rows="5" required></textarea></label><% if(turnstileSiteKey){ %><div class="cf-turnstile" data-sitekey="<%= turnstileSiteKey %>"></div><script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script><% }else{ %><label>Проверка: <%= typeof captchaQuestion!=='undefined'?captchaQuestion:'Решите пример' %><input name="answer" required inputmode="numeric"></label><% } %><button class="btn primary">Отправить</button></form><% } %></section><%- include('partials/footer') %>
