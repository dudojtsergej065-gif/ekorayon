<%- include('partials/header') %><section class="page-head"><span class="eyebrow">УЧАСТНИКИ ПРОЕКТА</span><h1><%= t('Школы района','Школы раёна') %></h1><p><%= t('Общий каталог образовательных учреждений, участвующих в ЭКОРАЙОНЕ.','Агульны каталог навучальных устаноў, якія ўдзельнічаюць у ЭКАРАЁНЕ.') %></p><form action="/search" class="searchbar"><input name="q" placeholder="<%= t('Найти школу или населённый пункт','Знайсці школу або населены пункт') %>"><button class="btn primary"><%= t('Найти','Знайсці') %></button></form></section><div class="school-grid"><% schools.forEach(s=>{ %><a class="school-card" href="/schools/<%= s.id %>"><div class="school-icon">⌂</div><div><h3><%= s.name %></h3><p><%= s.locality||'Населённый пункт не указан' %></p><strong><%= Number(s.total).toLocaleString('ru-RU') %> кг</strong></div></a><% }) %><% if(!schools.length){ %><div class="empty">Список школ будет опубликован после добавления учреждений администрацией.</div><% } %></div><%- include('partials/footer') %>
