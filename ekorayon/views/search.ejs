<%- include('partials/header') %><section class="page-head"><span class="eyebrow">ПОИСК ПО ПЛАТФОРМЕ</span><h1>Найти информацию</h1><form action="/search" class="searchbar"><input name="q" value="<%= term %>" placeholder="Школа, класс, новость, мероприятие"><button class="btn primary">Поиск</button></form></section><% if(term){ %><p class="muted">Результаты по запросу «<%= term %>»</p><div class="result-list"><% results.forEach(r=>{ %><a class="result" href="<%= r.url %>"><span class="tag"><%= r.type==='school'?'Школа':r.type==='class'?'Класс':'Новость' %></span><b><%= r.title %></b><small><%= r.subtitle %></small></a><% }) %><% if(!results.length){ %><div class="empty">Ничего не найдено.</div><% } %></div><% } %><%- include('partials/footer') %>
