<%- include('partials/header') %><section class="form-wrap wide"><span class="eyebrow">ПОДКЛЮЧЕНИЕ К ПРОЕКТУ</span><h1>Заявка на регистрацию школы</h1><% if(typeof success!=='undefined'&&success){ %><div class="notice"><%= success %></div><% }else{ %><form method="post" class="panel form two-col"><label>Полное официальное название *<input name="name" required></label><label>Населённый пункт<input name="locality"></label><label>Адрес<input name="address"></label><label>ФИО директора<input name="director"></label><label>Контакт ответственного лица *<input name="contact" required placeholder="Телефон или e-mail"></label><% if(turnstileSiteKey){ %><div class="cf-turnstile" data-sitekey="<%= turnstileSiteKey %>"></div><script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script><% }else{ %><label>Проверка: <%= typeof captchaQuestion!=='undefined'?captchaQuestion:'Решите пример' %><input name="answer" required inputmode="numeric"></label><% } %><button class="btn primary">Отправить заявку</button></form><% } %></section><%- include('partials/footer') %>
