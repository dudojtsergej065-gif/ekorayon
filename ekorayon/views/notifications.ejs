<%- include('partials/header') %><section class="page-head"><h1>Уведомления</h1></section><div class="result-list"><% items.forEach(n=>{ %><div class="result"><b><%= n.title %></b><p><%= n.body %></p><small><%= new Date(n.created_at).toLocaleString('ru-RU') %></small></div><% }) %><% if(!items.length){ %><div class="empty">Уведомлений пока нет.</div><% } %></div><%- include('partials/footer') %>
