<%- include('partials/header') %><section class="page-head"><h1>Обращения</h1></section><section class="section"><h2>Обратная связь и заявки</h2><div class="table-wrap"><table><thead><tr><th>Отправитель</th><th>Тема</th><th>Сообщение</th><th>Контакт / статус</th></tr></thead><tbody><% feedback.forEach(f=>{ %><tr><td><%= f.name %></td><td><%= f.subject %></td><td><%= f.message %></td><td><%= f.contact %><form method="post" action="/admin/feedback/<%= f.id %>/status" class="inline-form"><select name="status"><option value="new">Новое</option><option value="in_progress">В работе</option><option value="answered">Отвечено</option><option value="closed">Закрыто</option></select><button class="btn tiny">OK</button></form></td></tr><% }) %></tbody></table></div></section><section class="section"><h2>Техническая поддержка школ</h2><div class="news-grid"><% tickets.forEach(t=>{ %><div class="panel"><span class="tag"><%= t.school_name %> · <%= t.status %></span><h3><%= t.subject %></h3><p><%= t.message %></p><% if(t.admin_reply){ %><p><b>Ответ:</b> <%= t.admin_reply %></p><% } %><form method="post" action="/admin/tickets/<%= t.id %>/reply" class="stack-form"><textarea name="reply" rows="2" placeholder="Ответ школе" required></textarea><button class="btn small">Отправить ответ</button></form></div><% }) %></div></section><%- include('partials/footer') %>
