<%- include('partials/header') %>

<section class="home-hero">
  <div class="hero-orbit orbit-a"></div><div class="hero-orbit orbit-b"></div>
  <div class="hero-copy home-hero-copy">
    <div class="home-time-greeting" aria-live="polite">
      <span class="home-time-icon" id="homeTimeIcon" aria-hidden="true">☀️</span>
      <span><strong id="homeTimeGreeting">Добрый день!</strong><small>Рады видеть тебя в ЭКОРАЙОН</small></span>
    </div>
    <script>
      (() => {
        const greeting = document.getElementById('homeTimeGreeting');
        const icon = document.getElementById('homeTimeIcon');
        if (!greeting || !icon) return;
        const updateGreeting = () => {
          const hour = new Date().getHours();
          let message = 'Доброй ночи!', symbol = '🌙';
          if (hour >= 5 && hour < 12) { message = 'Доброе утро!'; symbol = '🌅'; }
          else if (hour >= 12 && hour < 18) { message = 'Добрый день!'; symbol = '☀️'; }
          else if (hour >= 18 && hour < 23) { message = 'Добрый вечер!'; symbol = '🌆'; }
          greeting.textContent = message;
          icon.textContent = symbol;
        };
        updateGreeting();
        window.setInterval(updateGreeting, 60000);
      })();
    </script>
    <span class="hero-kicker"><span class="live-dot"></span> <%= t('ЭКОЛОГИЧЕСКОЕ ДВИЖЕНИЕ ТВОЕГО РАЙОНА','ЭКАЛАГІЧНЫ РУХ ТВАЙГО РАЁНА') %></span>
    <h1><%= t('МЕНЯЙ МИР.','МЯНЯЙ СВЕТ.') %><br><span><%= t('НАЧНИ СО СВОЕЙ','ПАЧНІ СА СВАЁЙ') %></span><br><em><%= t('ШКОЛЫ.','ШКОЛЫ.') %></em></h1>
    <p><%= t('Собирай вторсырьё, участвуй в экоакциях, открывай достижения и помогай своему району становиться чище.','Збірай другасную сыравіну, удзельнічай у экаакцыях, адкрывай дасягненні і дапамагай свайму раёну станавіцца чысцейшым.') %></p>
    <div class="actions home-actions">
      <a class="btn primary" href="/schools"><%= t('Исследовать школы','Паглядзець школы') %> <span>↗</span></a>
      <a class="btn ghost" href="/about"><%= t('Как это работает?','Як гэта працуе?') %></a>
    </div>
    <div class="hero-social-proof"><span class="proof-icon">♻</span><span>Один район. Много команд.<br><b>Одна большая цель.</b></span></div>
  </div>
  <div class="home-hero-art" aria-label="Иллюстрация экологичного будущего">
    <div class="art-glow"></div><div class="planet-ring"></div><div class="planet"></div>
    <div class="art-spark spark-one">✦</div><div class="art-spark spark-two">✧</div><div class="art-spark spark-three">✳</div>
    <div class="art-cloud cloud-left"></div><div class="art-cloud cloud-right"></div>
    <div class="art-hill hill-back"></div><div class="art-hill hill-front"></div>
    <div class="art-tree tree-left"><i></i><b></b></div><div class="art-tree tree-right"><i></i><b></b></div>
    <div class="eco-tower"><span>♻</span><small>RE:START</small></div>
    <div class="floating-chip chip-top"><span>🌱</span> Действуй экологично</div>
    <div class="floating-chip chip-bottom"><span>⚡</span> Твой вклад важен</div>
    <div class="art-bottom-label">БУДУЩЕЕ НАЧИНАЕТСЯ ЗДЕСЬ <b>↗</b></div>
  </div>
  <div class="hero-bottom-line"><span>ЭКОРАЙОН / 2026</span><span>THINK GREEN · ACT NOW</span></div>
</section>

<section class="stats-grid home-stats">
