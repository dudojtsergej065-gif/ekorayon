<%- include('partials/header') %>
<section class="page-head"><span class="eyebrow"><%= lang==='by'?'ЭКАЛАГІЧНЫЯ МІСІІ':'ЭКОЛОГИЧЕСКИЕ МИССИИ' %></span><h1><%= lang==='by'?'Заданні для зялёных каманд':'Экозадания для команд' %></h1><p><%= lang==='by'?'Далучайцеся да добрых спраў, выконвайце заданні і атрымлівайце балы.':'Выполняйте добрые дела, участвуйте в экологических инициативах и зарабатывайте дополнительные баллы.' %></p></section>
<% if(adminMode){ %><section class="panel mission-admin-form"><h2>＋ Новое задание / Новае заданне</h2><form method="post" action="/admin/missions" class="stack-form"><label>Название (русский)<input name="title_ru" required></label><label>Назва (па-беларуску)<input name="title_by" required></label><label>Описание (русский)<textarea name="description_ru" rows="2" required></textarea></label><label>Апісанне (па-беларуску)<textarea name="description_by" rows="2" required></textarea></label><div class="form-grid"><label>Баллы / Балы<input type="number" name="points" min="0" max="10000" value="10" required></label><label>Начало / Пачатак<input type="date" name="starts_on"></label><label>Окончание / Завяршэнне<input type="date" name="ends_on"></label></div><button class="btn primary">Опубликовать / Апублікаваць</button></form></section><% } %>
<div class="mission-grid"><% missions.forEach(m=>{ %><article class="mission-card"><div class="mission-card-top"><span>🌿 ЭКОМИССИЯ</span><strong>＋<%= m.points %> баллов</strong></div><h2><%= lang==='by'?m.title_by:m.title_ru %></h2><p><%= lang==='by'?m.description_by:m.description_ru %></p><small><%= m.ends_on?(lang==='by'?'Да ':'До ')+new Date(m.ends_on).toLocaleDateString(lang==='by'?'be-BY':'ru-RU'):(lang==='by'?'Без тэрміну':'Без срока') %></small>
<% if(user&&user.role==='school'){ %><% if(m.submission_status){ %><span class="status <%= m.submission_status==='approved'?'approved':m.submission_status==='rejected'?'correction':'pending' %>"><%= m.submission_status==='approved'?'Подтверждено':m.submission_status==='rejected'?'Отклонено':'На проверке' %></span><% }else{ %><form method="post" action="/missions/<%= m.id %>/join" class="stack-form"><textarea name="note" rows="2" placeholder="<%= lang==='by'?'Каротка апішыце ўдзел':'Кратко опишите участие' %>"></textarea><button class="btn primary"><%= lang==='by'?'Адправіць справаздачу':'Отправить отчёт' %></button></form><% } %><% } %>
<% if(adminMode){ %><form method="post" action="/admin/missions/<%= m.id %>/status"><input type="hidden" name="active" value="<%= m.active?'false':'true' %>"><button class="btn small ghost"><%= m.active?'Скрыть':'Опубликовать' %></button></form><% } %></article><% }) %><% if(!missions.length){ %><div class="empty"><%= lang==='by'?'Заданні хутка з’явяцца!':'Новые задания скоро появятся!' %></div><% } %></div>
<% if(submissions&&submissions.length&&user&&['admin','staff'].includes(user.role)){ %><section class="section"><h2>Отчёты школ / Справаздачы школ</h2><div class="table-wrap"><table><thead><tr><th>Школа</th><th>Задание</th><th>Комментарий</th><th>Статус</th><th>Действие</th></tr></thead><tbody><% submissions.forEach(s=>{ %><tr><td><%= s.school_name %></td><td><%= s.title_ru %></td><td><%= s.note||'—' %></td><td><%= s.status %></td><td><% if(s.status==='pending'){ %><form method="post" action="/admin/missions/<%= s.id %>/review" class="inline"><input type="hidden" name="status" value="approved"><button class="btn tiny">Подтвердить</button></form><form method="post" action="/admin/missions/<%= s.id %>/review" class="inline"><input type="hidden" name="status" value="rejected"><button class="btn tiny danger">Отклонить</button></form><% } %></td></tr><% }) %></tbody></table></div></section><% } %>
<%- include('partials/footer') %>