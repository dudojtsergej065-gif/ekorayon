<%- include('partials/header') %>
<section class="battle-page">
 <div class="battle-hero"><span>⚡ <%= t('ШКОЛЬНАЯ ЭКО-АРЕНА','ШКОЛЬНАЯ ЭКА-АРЭНА') %></span><h1><%= t('ЭКО-БАТТЛЫ','ЭКА-БАТЛЫ') %></h1><p><%= t('Каждый месяц школы соревнуются за звание самой активной экологической команды. В зачёт идут только подтверждённые результаты текущего месяца.','Кожны месяц школы спаборнічаюць за званне самай актыўнай экалагічнай каманды. У залік ідуць толькі пацверджаныя вынікі бягучага месяца.') %></p><div class="battle-month">🏆 <%= new Date().toLocaleDateString(lang==='by'?'be-BY':'ru-RU',{month:'long',year:'numeric'}) %></div></div>
 <div class="battle-podium"><% schools.slice(0,3).forEach((s,i)=>{const avatars={sprout:'🌱',fox:'🦊',owl:'🦉',wolf:'🐺',dragon:'🐉',phoenix:'🔥'};%><article class="podium-card place-<%= i+1 %>"><span class="podium-medal"><%= ['🥇','🥈','🥉'][i] %></span><span class="podium-avatar"><%= avatars[s.avatar_code]||'🌱' %></span><b><%= s.name %></b><strong><%= Number(s.kg).toLocaleString('ru-RU') %> кг</strong><small>⭐ <%= Number(s.points).toLocaleString('ru-RU') %> <%= t('баллов','балаў') %></small></article><% }) %><% if(!schools.length){ %><p><%= t('Пока нет участников баттла.','Пакуль няма ўдзельнікаў батлу.') %></p><% } %></div>
 <section class="panel battle-ranking"><div class="section-head"><h2>⚡ <%= t('Турнирная таблица','Турнірная табліца') %></h2><span><%= t('Считаем только текущий месяц','Лічым толькі бягучы месяц') %></span></div><div class="hall-list"><% schools.forEach((s,i)=>{const avatars={sprout:'🌱',fox:'🦊',owl:'🦉',wolf:'🐺',dragon:'🐉',phoenix:'🔥'};%><div class="hall-row"><span class="hall-rank"><%= i+1 %></span><span class="world-team-avatar"><%= avatars[s.avatar_code]||'🌱' %></span><b><%= s.name %></b><strong><%= Number(s.kg).toLocaleString('ru-RU') %> кг</strong><small>⭐ <%= Number(s.points).toLocaleString('ru-RU') %></small></div><% }) %></div></section>
 <p class="battle-note"><%= t('Рейтинг обновляется после проверки администрацией. Это дружеское соревнование: главное — общий вклад в природу!','Рэйтынг абнаўляецца пасля праверкі адміністрацыяй. Гэта сяброўскае спаборніцтва: галоўнае — агульны ўклад у прыроду!') %></p>
</section>
<%- include('partials/footer') %>