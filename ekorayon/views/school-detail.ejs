<%- include('partials/header') %><section class="page-head school-identity"><span class="school-public-avatar"><%= ({sprout:"🌱",fox:"🦊",owl:"🦉",wolf:"🐺",dragon:"🐉",phoenix:"🔥"})[school.avatar_code]||"🌱" %></span><span class="eyebrow"><%= school.locality||'ШКОЛА-УЧАСТНИК' %></span><h1><%= school.name %></h1><p><%= school.address||'' %></p></section><div class="detail-grid"><section class="panel"><h2><%= t('О школе','Пра школу') %></h2><p><%= school.description||'Информация об учреждении будет добавлена администрацией.' %></p><p><b><%= t('Директор:','Дырэктар:') %></b> <%= school.director||'—' %></p><p><b><%= t('Контакты:','Кантакты:') %></b> <%= school.contact||'—' %></p><p><b><%= t('Учащихся:','Вучняў:') %></b> <%= school.students %></p></section><section class="panel"><h2><%= t('Сбор вторсырья','Збор другаснай сыравіны') %></h2><% stats.forEach(x=>{ %><div class="metric-row"><span><%= x.name %></span><b><%= Number(x.total).toLocaleString('ru-RU') %> кг</b></div><% }) %></section></div><section class="section"><h2><%= t('Классы','Класы') %></h2><div class="pill-list"><% classes.forEach(c=>{ %><span class="pill"><%= c.name %> · <%= c.students %> уч.</span><% }) %><% if(!classes.length){ %><p class="muted">Список классов пока не добавлен.</p><% } %></div></section><section class="section"><h2><%= t('Новости школы','Навіны школы') %></h2><div class="news-grid"><% news.forEach(n=>{ %><a class="news-card" href="/news/<%= n.id %>"><h3><%= n.title %></h3><p><%= n.body.slice(0,120) %></p></a><% }) %></div></section><%- include('partials/footer') %>
