<%- include('partials/header') %><section class="page-head"><span class="eyebrow">ЭКОСОБЫТИЯ</span><h1><%= t('Новости и мероприятия','Навіны і мерапрыемствы') %></h1><p><%= t('Новости школ, районные объявления и экологические акции.','Навіны школ, раённыя аб’явы і экалагічныя акцыі.') %></p></section><div class="news-grid"><% items.forEach(n=>{ %><a class="news-card" href="/news/<%= n.id %>"><span class="tag"><%= n.category %></span><h3><%= n.title %></h3><p><%= n.body.slice(0,170) %><%= n.body.length>170?'…':'' %></p><small><%= new Date(n.created_at).toLocaleDateString('ru-RU') %></small></a><% }) %><% if(!items.length){ %><div class="empty"><%= t('Материалы появятся после публикации.','Матэрыялы з’явяцца пасля публікацыі.') %></div><% } %></div><%- include('partials/footer') %>
