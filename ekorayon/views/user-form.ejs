<%- include('partials/header') %><section class="form-wrap wide"><h1>Создать аккаунт школы</h1><p class="muted">Создайте временный пароль и передайте его ответственному лицу безопасным способом.</p><form method="post" action="/admin/users" class="panel form"><label>Имя ответственного<input name="name" required></label><label>E-mail / логин<input type="email" name="email" required></label><label>Временный пароль (минимум 10 символов)<input type="password" name="password" minlength="10" required></label><label>Школа<select name="school_id" required><% schools.forEach(s=>{ %><option value="<%= s.id %>"><%= s.name %></option><% }) %></select></label><button class="btn primary">Создать аккаунт</button></form></section><%- include('partials/footer') %>
