<%- include('partials/header') %><section class="form-wrap wide"><span class="eyebrow">КАБИНЕТ ШКОЛЫ</span><h1>Новая запись вторсырья</h1><form method="post" action="/entries" class="panel form two-col"><label>Класс<select name="class_id"><option value="">Общий сбор школы</option><% classes.forEach(c=>{ %><option value="<%= c.id %>"><%= c.name %></option><% }) %></select></label><label>Кому оформить грамоту<select name="certificate_type" id="certificate-type"><option value="auto">Автоматически: школе или классу</option><option value="school">Школе</option><option value="class">Классу</option><option value="student">Ученику</option></select><small class="muted">Для грамоты ученику укажите имя и выберите класс.</small></label><label>Имя ученика (если грамота ученику)<input name="student_name" maxlength="120" placeholder="Фамилия и имя ученика"></label><label>Вид вторсырья<select name="material_code" required><% materials.forEach(m=>{ %><option value="<%= m.code %>"><%= m.name %></option><% }) %></select></label><label>Количество, кг<input type="number" name="quantity" min="0.01" step="0.01" required></label><label>Отчётный месяц<input type="month" name="period_month" value="<%= new Date().toISOString().slice(0,7) %>" required></label><label class="full">Комментарий (необязательно)<textarea name="note" rows="3"></textarea></label><button class="btn primary">Отправить запись</button></form></section><%- include('partials/footer') %>
