<%- include('partials/header') %>
<section class="eco-builder">
 <div class="builder-top"><div><span class="builder-kicker">✦ ТВОРЧЕСКАЯ ЭКО-ЛАБОРАТОРИЯ</span><h1>ГОРОД <em>БУДУЩЕГО</em></h1><p>Ты — главный архитектор. Построй район, в котором хочется жить, дышать и мечтать.</p></div><div class="builder-stamp">🏙️<small>ТВОЙ ПРОЕКТ<br>ТВОИ ПРАВИЛА</small></div></div>
 <div class="builder-layout">
  <aside class="builder-sidebar">
   <div class="builder-panel-head"><span>01 / ВЫБЕРИ ОБЪЕКТ</span><b>КАТАЛОГ</b></div>
   <div class="builder-palette" id="builderPalette">
    <button class="build-item selected" data-type="tree"><span>🌳</span><b>Дерево</b><small>Зелёные зоны +</small></button>
    <button class="build-item" data-type="park"><span>🌲</span><b>Парк</b><small>Природа +++</small></button>
    <button class="build-item" data-type="house"><span>🏡</span><b>Эко-дом</b><small>Жильё +</small></button>
    <button class="build-item" data-type="solar"><span>☀️</span><b>Солнечная станция</b><small>Чистая энергия +++</small></button>
    <button class="build-item" data-type="wind"><span>🌬️</span><b>Ветряк</b><small>Чистая энергия ++</small></button>
    <button class="build-item" data-type="bike"><span>🚲</span><b>Велопарковка</b><small>Мобильность ++</small></button>
    <button class="build-item" data-type="recycle"><span>♻️</span><b>Экопункт</b><small>Переработка +++</small></button>
    <button class="build-item" data-type="water"><span>💧</span><b>Пруд</b><small>Вода и жизнь ++</small></button>
    <button class="build-item" data-type="school"><span>🏫</span><b>Эко-школа</b><small>Образование ++</small></button>
    <button class="build-item" data-type="garden"><span>🥕</span><b>Огород</b><small>Локальная еда ++</small></button>
   </div>
   <div class="builder-hint">💡 Выбери объект, затем нажми на клетку поля. Нажми на занятую клетку, чтобы убрать объект.</div>
  </aside>
  <main class="builder-main">
   <div class="builder-board-head"><div><span>02 / ТВОЯ ТЕРРИТОРИЯ</span><h2>План района</h2></div><span class="builder-live"><i></i> РЕЖИМ СТРОИТЕЛЬСТВА</span></div>
   <div class="builder-board-wrap"><div class="builder-board" id="builderBoard" role="grid" aria-label="Поле строительства района"></div></div>
   <div class="builder-board-foot"><span>🟩 Свободная территория</span><span>Клик по объекту — убрать</span></div>
   <div class="builder-actions"><button class="builder-reset" id="builderReset">↻ Начать заново</button><button class="builder-random" id="builderRandom">✦ Удиви меня</button></div>
  </main>
  <aside class="builder-score">
   <div class="builder-panel-head"><span>03 / РЕЗУЛЬТАТ</span><b>ЭКОПАСПОРТ</b></div>
   <div class="builder-score-orb"><div><strong id="builderScore">0</strong><small>ЭКО-ОЧКОВ</small></div></div>
   <div class="builder-metrics"><div><span>🌿 Природа</span><b id="metricNature">0</b></div><div><span>⚡ Энергия</span><b id="metricEnergy">0</b></div><div><span>🚲 Мобильность</span><b id="metricMove">0</b></div><div><span>♻️ Цикличность</span><b id="metricCycle">0</b></div></div>
   <div class="builder-rating"><span>ТВОЙ УРОВЕНЬ</span><b id="builderRank">Начинающий архитектор</b><p id="builderAdvice">Добавь первые объекты и создай свой зелёный уголок.</p></div>
   <div class="builder-mission"><span>🎯 МИССИЯ АРХИТЕКТОРА</span><b id="builderMission">Создай парк и установи солнечную станцию.</b><small id="missionStatus">Выполни задание на своём поле!</small></div>
  </aside>
 </div>
 <div class="builder-bottom"><span>🌍 ЭКОРАЙОН · МАСТЕРСКАЯ БУДУЩЕГО</span><span>Это творческая игра. Результаты не сохраняются и не влияют на реальные рейтинги.</span></div>
</section>
<script>
(()=>{
 const board=document.getElementById('builderBoard');if(!board)return;
 const types={tree:{icon:'🌳',n:3},park:{icon:'🌲',n:7},house:{icon:'🏡',n:1},solar:{icon:'☀️',e:7},wind:{icon:'🌬️',e:5},bike:{icon:'🚲',m:6},recycle:{icon:'♻️',c:8},water:{icon:'💧',n:5},school:{icon:'🏫',m:2,n:1},garden:{icon:'🥕',n:3,c:2}};
 let selected='tree',cells=Array(80).fill(null),mission=0;
 const missions=[{text:'Создай парк и установи солнечную станцию.',test:a=>a.park>0&&a.solar>0},{text:'Построй эко-школу и экопункт.',test:a=>a.school>0&&a.recycle>0},{text:'Добавь минимум 5 деревьев.',test:a=>a.tree>=5},{text:'Создай район с чистой энергией: 2 станции или ветряка.',test:a=>a.solar+a.wind>=2},{text:'Построй огород и пруд.',test:a=>a.garden>0&&a.water>0}];
 function draw(){board.innerHTML='';cells.forEach((v,i)=>{const b=document.createElement('button');b.type='button';b.className='builder-cell'+(v?' occupied type-'+v:'');b.setAttribute('role','gridcell');b.setAttribute('aria-label',v?types[v].icon+' объект, нажми чтобы убрать':'Свободная клетка '+(i+1));b.textContent=v?types[v].icon:'';b.addEventListener('click',()=>{if(cells[i])cells[i]=null;else cells[i]=selected;draw();score()});board.appendChild(b)})}
 function score(){const a={tree:0,park:0,house:0,solar:0,wind:0,bike:0,recycle:0,water:0,school:0,garden:0};cells.filter(Boolean).forEach(x=>a[x]++);let n=a.tree*3+a.park*7+a.water*5+a.garden*3+a.school,e=a.solar*7+a.wind*5,m=a.bike*6+a.school*2,c=a.recycle*8+a.garden*2;const total=n+e+m+c+Math.min(30,a.park*3+a.recycle*2+a.solar*2);document.getElementById('builderScore').textContent=total;document.getElementById('metricNature').textContent=n;document.getElementById('metricEnergy').textContent=e;document.getElementById('metricMove').textContent=m;document.getElementById('metricCycle').textContent=c;let rank=total>=130?'Легенда экоархитектуры':total>=80?'Архитектор будущего':total>=40?'Зелёный проектировщик':total>=15?'Молодой архитектор':'Начинающий архитектор';document.getElementById('builderRank').textContent=rank;document.getElementById('builderAdvice').textContent=total>=80?'Невероятно! Твой район уже похож на город будущего.':total>=35?'Отличный старт! Добавь разнообразия и усили экологический баланс.':'Попробуй сочетать природу, чистую энергию и удобный транспорт.';const done=missionStatus(a);document.getElementById('builderMission').textContent=missions[mission].text;document.getElementById('missionStatus').textContent=done?'✓ МИССИЯ ВЫПОЛНЕНА! Отличная работа!':'Выполни задание на своём поле!'}
 function missionStatus(a){return missions[mission].test(a)}
 document.querySelectorAll('.build-item').forEach(b=>b.addEventListener('click',()=>{selected=b.dataset.type;document.querySelectorAll('.build-item').forEach(x=>x.classList.toggle('selected',x===b))}));
 document.getElementById('builderReset').addEventListener('click',()=>{cells=Array(80).fill(null);mission=(mission+1)%missions.length;draw();score()});
 document.getElementById('builderRandom').addEventListener('click',()=>{const keys=Object.keys(types);cells=cells.map(()=>Math.random()<.48?keys[Math.floor(Math.random()*keys.length)]:null);mission=(mission+1)%missions.length;draw();score()});
 draw();score();
})();
</script>
<%- include('partials/footer') %>