<%- include('partials/header') %><section class="page-head"><span class="eyebrow">🌍 ЭКОЛОГИЧЕСКИЙ ЭФФЕКТ</span><h1><%= lang==='by'?'Вынік нашых дзеянняў':'Результат наших действий' %></h1><p><%= lang==='by'?'Кожны пацверджаны кілаграм — крок да чысцейшага раёна.':'Каждый подтверждённый килограмм — вклад в более чистый район.' %></p></section><div class="stats-grid impact-stats"><div class="stat"><span>♻ Собрано / Сабрана</span><strong><%= Number(totals.kg).toLocaleString('ru-RU') %> <small>кг</small></strong></div><div class="stat"><span>🏫 Школ-участниц / Школ</span><strong><%= totals.schools %></strong></div><div class="stat"><span>📋 Подтверждено записей / Запісаў</span><strong><%= totals.entries %></strong></div><div class="stat"><span>🌱 Выполнено миссий / Місій</span><strong><%= events.count %></strong></div></div><section class="section panel"><h2><%= lang==='by'?'Структура збору':'Структура сбора' %></h2><div class="impact-materials"><% materials.forEach(m=>{ %><div class="impact-material-row"><span><%= m.name %></span><div class="impact-track"><i style="width:<%= Math.max(0,Math.min(100,Number(totals.kg)>0?Number(m.total)/Number(totals.kg)*100:0)) %>%"></i></div><b><%= Number(m.total).toLocaleString('ru-RU') %> кг</b></div><% }) %></div></section><%- include('partials/footer') %>