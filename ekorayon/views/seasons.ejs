<%- include('partials/header') %><section class="page-head"><span class="eyebrow">🍃 СОРЕВНОВАНИЯ</span><h1><%= lang==='by'?'Экасезоны':'Экосезоны' %></h1><p><%= lang==='by'?'Вынікі пацверджаных здач у бягучым месяцы і годзе.':'Соревнования по подтверждённым сдачам в текущем месяце и году.' %></p></section><div class="detail-grid"><section class="panel"><h2>⚡ <%= lang==='by'?'Рэйтынг месяца':'Рейтинг месяца' %></h2><div class="hall-list"><% month.forEach((s,i)=>{ %><div class="hall-row"><span class="hall-rank"><%= i+1 %></span><b><%= s.name %></b><strong><%= Number(s.total).toLocaleString('ru-RU') %> кг</strong></div><% }) %><% if(!month.length){ %><div class="empty">Пока нет подтверждённых результатов.</div><% } %></div></section><section class="panel"><h2>🏆 <%= lang==='by'?'Вынікі года':'Итоги года' %></h2><div class="hall-list"><% year.forEach((s,i)=>{ %><div class="hall-row"><span class="hall-rank"><%= i+1 %></span><b><%= s.name %></b><strong><%= Number(s.total).toLocaleString('ru-RU') %> кг</strong></div><% }) %><% if(!year.length){ %><div class="empty">Пока нет подтверждённых результатов.</div><% } %></div></section></div><%- include('partials/footer') %>